# Copy to .env and fill in. Never commit .env.

# ProtonVPN WireGuard private key: ProtonVPN account → Downloads → WireGuard configuration,
# generate a config with "NAT-PMP (Port Forwarding)" enabled and copy the PrivateKey line.
WG_PRIVATE_KEY=

# Jellystat database password and token secret: any long random strings,
# e.g. `openssl rand -base64 32`.
JELLYSTAT_DB_PASSWORD=
JELLYSTAT_JWT_SECRET=

# API keys used by Unpackerr: Radarr / Sonarr → Settings → General → API Key.
RADARR_API=
SONARR_API=

JELLYFIN_URL=